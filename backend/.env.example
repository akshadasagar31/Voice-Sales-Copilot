# FastAPI Backend Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Embeddings Configuration (Module 2 Step 4)
# Provider options: 'local_fast' (zero external API key needed, deterministic normalized dense vectors) or 'openai'
EMBEDDING_PROVIDER=local_fast
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=

# Pinecone Configuration (Module 2 Step 5)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=voice-sales-copilot
PINECONE_ENVIRONMENT=us-east-1
PINECONE_NAMESPACE=sales_playbooks

# OpenRouter LLM Configuration (Module 2 Step 7)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_FALLBACK_MESSAGE=I am sorry, but the provided documentation does not contain sufficient information to answer this question.

# Deepgram STT Configuration (Module 1 Step 2)
DEEPGRAM_API_KEY=


